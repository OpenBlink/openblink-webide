{
  "name": "openblink-webide",
  "private": true,
  "version": "0.3.6",
  "description": "OpenBlink WebIDE - browser-based Ruby development for OpenBlink devices",
  "license": "BSD-3-Clause",
  "scripts": {
    "lint": "eslint public_html/js public_html/lib public_html/boards scripts src/app src/codemirror tests",
    "lint:html": "htmlhint \"public_html/**/*.html\"",
    "lint:json": "node scripts/validate-json.js",
    "lint:static": "node scripts/validate-static-assets.js",
    "check-version": "node scripts/check-version.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "esbuild-css-modules-plugin": "^3.1.5"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
